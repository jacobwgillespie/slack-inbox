{
  "name": "slack-inbox",
  "private": true,
  "version": "0.9.0",
  "packageManager": "pnpm@12.6.0",
  "repository": "https://github.com/jacobwgillespie/slack-inbox",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "description": "A keyboard-driven inbox for Slack conversations",
  "author": "Jacob Gillespie",
  "scripts": {
    "dev": "pnpm desktop",
    "build": "pnpm icons && node scripts/build-emoji.mjs && tsc -b && vite build",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc -b",
    "desktop:build": "pnpm build && node scripts/build-desktop.mjs",
    "desktop": "pnpm exec install-electron && pnpm desktop:build && node scripts/start-desktop.mjs",
    "desktop:package": "pnpm exec install-electron && pnpm desktop:build && electron-builder --mac --publish never --config.mac.identity=- --config.mac.notarize=false --config.mac.hardenedRuntime=false",
    "desktop:release": "pnpm exec install-electron && pnpm desktop:build && electron-builder --mac --arm64 --x64 --publish never --config.forceCodeSigning=true"
  },
  "build": {
    "appId": "com.jacobwgillespie.slack-inbox",
    "productName": "Slack Inbox",
    "artifactName": "Slack-Inbox-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "jacobwgillespie",
      "repo": "slack-inbox"
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "dmg": {
      "background": "assets/dmg-background.png",
      "contents": [
        { "x": 130, "y": 183, "type": "file" },
        { "x": 410, "y": 183, "type": "link", "path": "/Applications" }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@tanstack/react-db": "^0.4.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "electron-native-auth": "0.2.0",
    "electron-updater": "6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "emoji-datasource": "16.0.0",
    "esbuild": "^0.28.2",
    "node-gyp": "^13.0.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
