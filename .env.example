SLACK_USER_TOKEN=xoxp-your-user-token

# Optional. Makes each scan take seconds instead of minutes. See the README.
# SLACK_SESSION_TOKEN=xoxc-your-session-token
# SLACK_SESSION_COOKIE=xoxd-your-d-cookie-value

# Optional. Sorts new messages into Important and Other with an OpenAI model. See the README.
# OPENAI_API_KEY=sk-your-key
# OPENAI_CLASSIFIER_MODEL=gpt-6-luna
